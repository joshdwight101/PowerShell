{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-integrity-gui",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/SystemIntegritySuite/IntegrityCheckGui.csproj",
        "/property:GenerateFullPaths=true"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish-integrity-gui-single-file",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/SystemIntegritySuite/IntegrityCheckGui.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "true",
        "/p:PublishSingleFile=true",
        "/p:IncludeNativeLibrariesForSelfExtract=true"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
